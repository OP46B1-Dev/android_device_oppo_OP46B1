allow hal_sensors_default vendor_proc_display:dir search;
allow hal_sensors_default vendor_proc_display:file rw_file_perms;
allow hal_sensors_default vendor_sysfs_graphics:dir search;
allow hal_sensors_default vendor_sysfs_graphics:file r_file_perms;
allow hal_sensors_default sysfs_touchpanel:dir search;
allow hal_sensors_default sysfs_touchpanel:file rw_file_perms;

dontaudit hal_sensors_default system_prop:file { read open getattr };
