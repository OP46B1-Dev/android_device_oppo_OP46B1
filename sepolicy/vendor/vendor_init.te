set_prop(vendor_init, fm_prop)
set_prop(vendor_init, freq_prop)
set_prop(vendor_init, oppo_debug_prop)
set_prop(vendor_init, vendor_camera_prop)

get_prop(vendor_init, persist_debug_prop)

allow vendor_init block_device:lnk_file setattr;

typeattribute vendor_init data_between_core_and_vendor_violators;
allow vendor_init {
  system_data_file
  tombstone_data_file
}:dir { create_dir_perms relabelfrom };

dontaudit vendor_init { default_prop radio_prop vendor_mm_parser_prop }:property_service set;
