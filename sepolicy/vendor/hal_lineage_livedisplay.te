# DC dimming (anti-flicker), seed (display modes) and hbm (sunlight
# enhancement) nodes under /sys/kernel/oppo_display
allow hal_lineage_livedisplay_sysfs vendor_sysfs_graphics:dir search;
allow hal_lineage_livedisplay_sysfs vendor_sysfs_graphics:file rw_file_perms;

# Persisted default display mode (/data/vendor/display)
allow hal_lineage_livedisplay_sysfs display_vendor_data_file:dir create_dir_perms;
allow hal_lineage_livedisplay_sysfs display_vendor_data_file:file create_file_perms;
