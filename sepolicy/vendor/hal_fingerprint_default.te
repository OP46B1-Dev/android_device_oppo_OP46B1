allow hal_fingerprint_default tee_device:chr_file rw_file_perms;
allow hal_fingerprint_default fingerprint_device:chr_file rw_file_perms;

allow hal_fingerprint_default hal_fingerprint_default:binder { call transfer };

allow hal_fingerprint_default self:netlink_socket create_socket_perms_no_ioctl;

allow hal_fingerprint_default vendor_proc_display:dir search;
allow hal_fingerprint_default vendor_proc_display:file rw_file_perms;

type hal_orms_hwservice, hwservice_manager_type;
type hal_commondcs_hwservice, hwservice_manager_type;
allow hal_fingerprint_default { hal_orms_hwservice hal_commondcs_hwservice }:hwservice_manager find;

allow hal_fingerprint_default vendor_sysfs_graphics:dir search;
allow hal_fingerprint_default vendor_sysfs_graphics:file rw_file_perms;

allow hal_fingerprint_default xdsp_device:chr_file rw_file_perms;

allow hal_fingerprint_default vendor_proc_fingerprint:file r_file_perms;

get_prop(hal_fingerprint_default, adsprpc_prop)

set_prop(hal_fingerprint_default, vendor_fingerprint_prop)

dontaudit hal_fingerprint_default default_prop:file { read open getattr };
