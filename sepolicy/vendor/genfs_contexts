# Display
genfscon proc /devinfo/lcd       u:object_r:vendor_proc_display:s0
genfscon proc /devinfo/tp        u:object_r:vendor_proc_display:s0
genfscon proc /touchpanel        u:object_r:vendor_proc_display:s0
genfscon sysfs /kernel/oppo_display    u:object_r:vendor_sysfs_graphics:s0

# Touchpanel (double tap to wake)
genfscon sysfs /touchpanel             u:object_r:sysfs_touchpanel:s0

# Fingerprint
genfscon proc /fp_id             u:object_r:vendor_proc_fingerprint:s0

# USB
genfscon sysfs /devices/platform/soc/a600000.ssusb/mode    u:object_r:vendor_sysfs_usb_mode:s0
genfscon sysfs /devices/platform/soc/c440000.qcom,spmi/spmi-0/spmi0-00/c440000.qcom,spmi:qcom,pm660@0:qcom,qpnp-smb2/power_supply/ac    u:object_r:sysfs_usb_supply:s0

# Versioning
genfscon proc /oplusVersion      u:object_r:vendor_proc_oplus_version:s0
genfscon proc /oppoVersion       u:object_r:vendor_proc_oplus_version:s0

# Camera motor
genfscon sysfs /class/motor      u:object_r:sysfs_motor:s0
