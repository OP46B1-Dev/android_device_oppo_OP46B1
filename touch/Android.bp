// Touch HAL - HighTouchPollingRate and TouchscreenGesture services for
// OP46B1, backed by the Synaptics S3706 touchpanel proc interface.
//
// SPDX-License-Identifier: Apache-2.0

cc_binary {
    name: "vendor.lineage.touch@1.0-service.OP46B1",
    defaults: ["hidl_defaults"],
    init_rc: ["vendor.lineage.touch@1.0-service.OP46B1.rc"],
    vintf_fragments: ["vendor.lineage.touch@1.0-service.OP46B1.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "HighTouchPollingRate.cpp",
        "TouchscreenGesture.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libhidlbase",
        "libutils",
        "vendor.lineage.touch@1.0",
    ],
}
