//
// Screen-off UDFPS trigger and double-tap-to-wake sub-HAL. Polls the
// touchpanel-reported fp_state / double_tap_state nodes and emits one-shot
// org.lineageos.sensor.udfps / org.lineageos.sensor.double_tap events so the
// framework can wake on UDFPS touches and double taps while the panel is off.

cc_library_shared {
    name: "sensors.oplus",
    defaults: ["hidl_defaults"],
    srcs: [
        "Sensor.cpp",
        "SensorsSubHal.cpp",
    ],
    shared_libs: [
        "android.hardware.sensors@1.0",
        "android.hardware.sensors@2.0",
        "android.hardware.sensors@2.0-ScopedWakelock",
        "android.hardware.sensors@2.1",
        "libcutils",
        "libfmq",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libpower",
        "libutils",
    ],
    static_libs: [
        "android.hardware.sensors@1.0-convert",
        "android.hardware.sensors@2.X-multihal",
    ],
    cflags: [
        "-DLOG_TAG=\"sensors.oplus\"",
    ],
    vendor: true,
}
