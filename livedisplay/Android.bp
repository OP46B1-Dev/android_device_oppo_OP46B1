// LiveDisplay HAL - AntiFlicker (DC dimming), DisplayModes and
// SunlightEnhancement services for OP46B1, backed by the oppo display sysfs
// interface (/sys/kernel/oppo_display).
//
// SPDX-License-Identifier: Apache-2.0

cc_binary {
    name: "vendor.lineage.livedisplay@2.1-service.OP46B1",
    defaults: ["hidl_defaults"],
    init_rc: ["vendor.lineage.livedisplay@2.1-service.OP46B1.rc"],
    vintf_fragments: ["vendor.lineage.livedisplay@2.1-service.OP46B1.xml"],
    relative_install_path: "hw",
    srcs: [
        "AntiFlicker.cpp",
        "DisplayModes.cpp",
        "SunlightEnhancement.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder",
        "libhidlbase",
        "libutils",
        "vendor.lineage.livedisplay@2.1",
    ],
    header_libs: ["vendor.lineage.livedisplay@2.1-OP46B1-headers"],
    vendor: true,
    proprietary: true,
}

cc_library_headers {
    name: "vendor.lineage.livedisplay@2.1-OP46B1-headers",
    vendor_available: true,
    export_include_dirs: ["include"],
}
