// LiveDisplay HAL - AntiFlicker (DC dimming), DisplayModes and
// SunlightEnhancement services for OP46B1, backed by the oppo display sysfs
// interface (/sys/kernel/oppo_display).
//
// SPDX-License-Identifier: Apache-2.0

cc_binary {
    name: "vendor.lineage.livedisplay-service.OP46B1",
    init_rc: ["vendor.lineage.livedisplay-service.OP46B1.rc"],
    vintf_fragments: ["vendor.lineage.livedisplay-service.OP46B1.xml"],
    relative_install_path: "hw",
    srcs: [
        "AntiFlicker.cpp",
        "DisplayModes.cpp",
        "SunlightEnhancement.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "vendor.lineage.livedisplay-V1-ndk",
    ],
    vendor: true,
    proprietary: true,
}
