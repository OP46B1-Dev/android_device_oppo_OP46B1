#
# Keylayout for the "touchpanel" input device (Synaptics S3706).
# The touchpanel driver reports double tap to wake as scancode 143
# (KEY_WAKEUP) while suspended; mapping it to KEYCODE_WAKEUP lets the input
# stack wake the device through PhoneWindowManager.

key 143   WAKEUP
