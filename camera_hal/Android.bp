cc_binary {
    name: "android.hardware.camera.provider@2.4-service_64.OP46B1",
    defaults: ["hidl_defaults"],
    proprietary: true,
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "src/CameraSignalEmitter.cpp",
        "src/CameraProviderWrapper.cpp",
        "src/CameraDeviceWrapper.cpp",
        "src/CameraDeviceSessionWrapper.cpp",
        "src/service.cpp",
    ],
    local_include_dirs: ["include"],
    init_rc: ["android.hardware.camera.provider@2.4-service_64.OP46B1.rc"],

    shared_libs: [
        "libbase",
        "libbinder",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
        "libcamera_metadata",
        "android.hardware.camera.provider@2.4",
        "android.hardware.camera.provider@2.4-impl",
        "android.hardware.camera.device@3.2",
        "android.hardware.camera.common@1.0",
    ],

    cflags: [
        "-Wthread-safety",
    ],
}
