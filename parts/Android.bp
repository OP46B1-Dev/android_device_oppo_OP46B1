// OPlusParts - Device-specific parts for OP46B1
// First feature: DC dimming
//
// SPDX-License-Identifier: Apache-2.0

android_app {
    name: "OPlusParts",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.preference_preference",
        "SettingsLib",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
